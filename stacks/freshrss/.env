BASE_URL=https://freshrss.{{op://docker/home_address/url/url}}
ADMIN_EMAIL={{op://docker/email/email/email}}
ADMIN_PASSWORD={{op://docker/freshrss/password}}
ADMIN_API_PASSWORD={{op://docker/freshrss/api/api_password}}
